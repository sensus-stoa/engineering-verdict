{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-manifest.schema.json",
  "$comment": "Evidence Bundle schema (map v3.6 §3.3), derived from live V-PTM-001 evidence-manifest.json. One schema, two directions: client fills as input package, provider adds roles/hashes. Role vocabulary (owner decision, incident I-002): two sets - spec §3.7 (client-generated, client-executed, provider-verified, independently reproduced) for client engagements; author-generated/author-executed/author-reported ONLY for public self-audit without a client. Mixing the two sets within one manifest is rejected. author-* is not legacy; no migration planned. protocol_version frozen at CV0-TrustLayer-v3.5 (v3.6 is the map version, not the protocol).",
  "title": "Evidence Bundle (evidence-manifest)",
  "type": "object",
  "required": ["schema", "protocol_version", "date", "object", "criteria_lock", "evidence", "controls"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "schema": { "const": "trust-manifest/v3.5" },
    "protocol_version": { "const": "CV0-TrustLayer-v3.5" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "object": {
      "type": "object",
      "required": ["repo", "commit"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "repo": { "type": "string", "pattern": "^https?://" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "criteria_lock": {
      "type": "object",
      "required": ["commit", "date", "note"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "role", "disclosure"],
        "additionalProperties": false,
        "patternProperties": { "^_": {} },
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "type": { "enum": ["code", "dependencies", "summary", "run-output", "publication", "config", "log", "seed", "dataset"] },
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "sha256": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "role": {
            "enum": [
              "client-generated",
              "client-executed",
              "provider-verified",
              "independently reproduced",
              "author-generated",
              "author-executed",
              "author-reported"
            ]
          },
          "disclosure": { "enum": ["public", "client", "sealed"] },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        },
        "anyOf": [
          { "required": ["path"] },
          { "required": ["url"] }
        ],
        "allOf": [
          {
            "if": { "required": ["path"] },
            "then": { "required": ["sha256"] }
          },
          {
            "if": { "properties": { "sha256": { "type": "null" } }, "required": ["sha256"] },
            "then": { "required": ["note"], "properties": { "note": { "type": "string", "minLength": 1 } } }
          }
        ]
      },
      "allOf": [
        {
          "if": { "contains": { "properties": { "role": { "pattern": "^author-" } }, "required": ["role"] } },
          "then": { "items": { "properties": { "role": { "pattern": "^author-" } } } }
        },
        {
          "if": { "contains": { "properties": { "role": { "enum": ["client-generated", "client-executed", "provider-verified", "independently reproduced"] } }, "required": ["role"] } },
          "then": { "items": { "properties": { "role": { "not": { "pattern": "^author-" } } } } }
        }
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "N"],
        "additionalProperties": false,
        "patternProperties": { "^_": {} },
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "description": { "type": "string" },
          "N": { "type": "integer", "minimum": 1 },
          "rejections": { "type": "integer", "minimum": 0 },
          "rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "wilson_ci_95": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "note": { "type": "string" }
        }
      }
    },
    "disclosure_levels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": { "type": ["string", "null"] },
        "client": { "type": ["string", "null"] },
        "sealed": { "type": ["string", "null"] }
      }
    }
  }
}
